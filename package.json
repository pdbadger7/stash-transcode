{
  "name": "stash-external-transcode",
  "version": "0.1.0",
  "description": "External transcoding service for Stash with plugin",
  "private": true,
  "workspaces": [
    "plugin",
    "agent"
  ],
  "scripts": {
    "install-all": "npm install && npm -w plugin install && npm -w agent install",
    "dev:agent": "npm -w agent run dev",
    "build:agent": "npm -w agent run build",
    "build:plugin": "npm -w plugin run build",
    "test:agent": "npm -w agent run test",
    "test:plugin": "npm -w plugin run test",
    "lint:agent": "npm -w agent run lint",
    "lint:plugin": "npm -w plugin run lint"
  }
}
